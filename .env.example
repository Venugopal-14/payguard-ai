# Application
APP_NAME=PayGuard AI
ENVIRONMENT=development

# Database (compose service name is "postgres")
POSTGRES_DB=payguard
POSTGRES_USER=payguard
POSTGRES_PASSWORD=payguard_dev_password
DATABASE_URL=postgresql+psycopg://payguard:payguard_dev_password@postgres:5432/payguard

# PayPal Sandbox  -- get these from https://developer.paypal.com/dashboard/
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal dashboard (needed to verify webhook signatures).
PAYPAL_WEBHOOK_ID=

# Where PayPal redirects the buyer after approval / cancellation.
FRONTEND_URL=http://localhost:3100

# AI provider. Ollama is used first if set, else OpenAI, else rule-based fallback.
# Local Ollama (free, OpenAI-compatible). Backend runs in Docker, so use host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI-compatible API (used only if Ollama is not configured):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend -> backend URL (browser calls this)
NEXT_PUBLIC_API_URL=http://localhost:8100
